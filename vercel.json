{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "site",
  "installCommand": "echo skip-install",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/dashboard/referral", "destination": "/dashboard/referrals/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sdoykujqzpppwpropsdo.supabase.co/functions/v1/api/:path*" },
    { "source": "/api", "destination": "https://sdoykujqzpppwpropsdo.supabase.co/functions/v1/api" },

    { "source": "/store/:slug/dashboard/:rest*", "destination": "/dashboard/:rest*" },
    { "source": "/store/:slug/admin/:rest*", "destination": "/admin/:rest*" },
    { "source": "/store/:slug/login", "destination": "/store/login.html" },
    { "source": "/store/:slug/register", "destination": "/store/register.html" },
    { "source": "/store/:slug/account", "destination": "/store/account.html" },
    { "source": "/store/:slug", "destination": "/index.html" },
    { "source": "/store/:slug/", "destination": "/index.html" },
    { "source": "/store/:slug/:page", "destination": "/:page/index.html" },
    { "source": "/store/:slug/:page/", "destination": "/:page/index.html" },
    { "source": "/store/:slug/:dir/:page", "destination": "/:dir/:page/index.html" },
    { "source": "/store/:slug/:dir/:page/", "destination": "/:dir/:page/index.html" },
    { "source": "/store/:slug/:dir/:sub/:page", "destination": "/:dir/:sub/:page/index.html" },
    { "source": "/store/:slug/:dir/:sub/:page/", "destination": "/:dir/:sub/:page/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/dashboard/config.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
